PORT=2486
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/furfriend_finder
APP_BASE_URL=http://localhost:2486
FRONTEND_URL=http://localhost:2486
BETTER_AUTH_URL=http://localhost:2486
EMAIL_VERIFY_CALLBACK_URL=http://localhost:2486/verify-email
CORS_ALLOWED_ORIGINS=http://localhost:2486

# Optional Google OAuth. Set true only after configuring the exact callback URI:
# http://localhost:2486/api/auth/callback/google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEOCODING_API_KEY=your-google-geocoding-api-key
CHANNEL_SECRET=your-line-channel-secret
CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
ADMIN_API_KEY=replace-with-a-long-random-string

# Mailgun SMTP
# Prerequisite: your Mailgun sending domain is verified with SPF/DKIM configured.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@mg.example.com
SMTP_PASSWORD=your-mailgun-smtp-password
SMTP_SENT_FROM=FurFriend Finder <noreply@mg.example.com>

# Optional: only used by the manual smoke test script.
SMTP_TEST_TO=you@example.com

# Grafana
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
