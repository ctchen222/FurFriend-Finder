{
  "name": "furfriend-finder",
  "version": "1.0.0",
  "description": "A pet adoption notification system",
  "main": "app.js",
  "scripts": {
    "copy-html": "copyfiles -u 1 src/public/*.html dist",
    "copy-assets": "copyfiles -u 1 \"src/public/css/**\" \"src/public/js/**\" dist",
    "build": "rimraf dist && npm run copy-html && npm run copy-assets && npx tsc",
    "prerestart": "npm run build",
    "dev": "tsx watch src/main.ts",
    "start": "npx tsc -w & nodemon dist/app.js",
    "start:prod": "npm run build && npx tsc -w && pm2 start dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern='src/__test__/unit'",
    "test:integration": "jest --testPathPattern='src/__test__/integration'",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "smtp:smoke": "tsx src/scripts/mailgun-smoke-test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@line/bot-sdk": "^9.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.215.0",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.215.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-logs": "^0.215.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@opentelemetry/winston-transport": "^0.25.0",
    "@types/express": "^4.17.21",
    "@types/mustache": "^4.2.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.1",
    "axios": "^1.7.5",
    "better-auth": "^1.3.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.2",
    "fs-extra": "^11.3.1",
    "geolib": "^3.3.4",
    "line-notify": "^1.0.0",
    "messaging-api-line": "^1.1.0",
    "morgan": "^1.10.1",
    "mustache": "^4.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "rimraf": "^6.0.1",
    "sequelize": "^6.37.3",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.55.1",
    "@types/cors": "^2.8.17",
    "@types/express-session": "^1.18.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "babel-jest": "^29.7.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "prisma": "^5.18.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  }
}
