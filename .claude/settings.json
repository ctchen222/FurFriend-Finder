{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
   },
  "teammateMode": "tmux",
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh api*pulls/*/merge*)",
      "Bash(gh api*git/refs/heads/main*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push* origin main*)"
    ]
  }
}
