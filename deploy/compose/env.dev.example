COMPOSE_PROJECT_NAME=furfriend-dev
APP_ENV_FILE=/etc/furfriend/dev.env

IMAGE_REPOSITORY=ghcr.io/ctchen222/furfriend-finder
IMAGE_DIGEST=sha256:replace-with-an-immutable-image-digest
MAILPIT_IMAGE=axllent/mailpit:v1.21.8
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2025.4.0
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/furfriend/dev.cloudflare-tunnel-token

APP_MEMORY_LIMIT=384m
WORKER_MEMORY_LIMIT=256m
POSTGRES_MEMORY_LIMIT=512m
MAILPIT_MEMORY_LIMIT=128m
CLOUDFLARED_MEMORY_LIMIT=128m

PORT=2486
NODE_ENV=production
WORKER_COUNT=1
DATABASE_URL=postgresql://furfriend_dev:replace-with-db-password@postgres:5432/furfriend_dev
POSTGRES_DB=furfriend_dev
POSTGRES_USER=furfriend_dev
POSTGRES_PASSWORD=replace-with-db-password

APP_BASE_URL=https://dev.furfriend-finder.com
FRONTEND_URL=https://dev.furfriend-finder.com
BETTER_AUTH_URL=https://dev.furfriend-finder.com
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
EMAIL_VERIFY_CALLBACK_URL=https://dev.furfriend-finder.com/verify-email
CORS_ALLOWED_ORIGINS=https://dev.furfriend-finder.com

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEOCODING_API_KEY=replace-with-dev-key
CHANNEL_SECRET=replace-with-dev-line-secret
CHANNEL_ACCESS_TOKEN=replace-with-dev-line-token
ADMIN_API_KEY=replace-with-a-long-random-string

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_SENT_FROM=FurFriend Finder Dev <dev@example.invalid>
SMTP_TEST_TO=

DISABLE_DATA_CRON=true
THREADS_ENABLED=false
THREADS_ACCESS_TOKEN=
OTEL_SDK_DISABLED=true
