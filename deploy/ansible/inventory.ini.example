# Copy this file to inventory.ini and fill in your VPS details.
# inventory.ini is gitignored — never commit it.
#
# ansible_user: the SSH user on your VPS (commonly ubuntu or root)
# ansible_ssh_private_key_file: path to your SSH private key on your local machine

[vps]
furfinder ansible_host=YOUR_VPS_IP \
           ansible_user=ubuntu \
           ansible_ssh_private_key_file=~/.ssh/id_ed25519
