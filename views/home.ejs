<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '首頁' }) %>
</head>
<body>
    <%- include('partials/_header') %>

    <main>
        <section class="home-hero">
            <div class="hero-copy">
                <p class="eyebrow">Taiwan shelter-data matching</p>
                <h1 class="hero-title">Find lost pets across Taiwan shelter records.</h1>
                <p class="hero-subtitle">
                    輸入走失地點與外觀特徵，FurFriend Finder 會比對全台公開收容資料，
                    讓你更快找到可能的線索。
                </p>
            </div>

            <div class="hero-action-panel" aria-label="主要操作">
                <a href="/quick-use" class="action-card action-card--primary">
                    <span class="action-kicker">No login required</span>
                    <strong>快速比對</strong>
                    <span>先用物種、毛色與地點找出可能候選。</span>
                </a>
                <a href="/report-lost" class="action-card">
                    <span class="action-kicker">Ongoing follow-up</span>
                    <strong>協尋登記</strong>
                    <span>建立案件並保留後續 Email 通知機會。</span>
                </a>
                <a href="/shelter-animals" class="action-card">
                    <span class="action-kicker">Browse records</span>
                    <strong>瀏覽收容動物</strong>
                    <span>以縣市、物種、性別篩選公開資料。</span>
                </a>
            </div>

            <div class="trust-row" aria-label="平台重點">
                <span>公立收容所公開資料</span>
                <span>地理距離排序</span>
                <span>Email 配對通知</span>
            </div>
        </section>

        <section class="content-band">
            <div class="section-heading">
                <p class="eyebrow">Daily record</p>
                <h2>今日推薦動物</h2>
                <a href="/shelter-animals">查看全部</a>
            </div>
            <div id="featured-animal" class="featured-card">
                <p class="featured-loading">載入中...</p>
            </div>
        </section>

        <section class="workflow-section">
            <div class="section-heading section-heading--center">
                <p class="eyebrow">How matching works</p>
                <h2>從焦慮到下一步，只保留必要流程</h2>
            </div>
            <div class="steps-grid">
                <article class="step-card">
                    <span class="step-num">1</span>
                    <h3>描述特徵</h3>
                    <p>輸入物種、毛色、品種與走失地點。資訊越準確，候選排序越有參考價值。</p>
                </article>
                <article class="step-card">
                    <span class="step-num">2</span>
                    <h3>比對收容資料</h3>
                    <p>系統先找出外觀相近的公開收容資料，再依地理距離排序。</p>
                </article>
                <article class="step-card">
                    <span class="step-num">3</span>
                    <h3>採取行動</h3>
                    <p>查看候選照片與收容所資訊，或建立協尋案件保留後續通知。</p>
                </article>
            </div>
        </section>

        <section class="bottom-cta">
            <p class="eyebrow">Start from the fastest path</p>
            <h2>先比對，再決定是否建立協尋案件。</h2>
            <div class="cta-container">
                <a href="/quick-use" class="btn btn-primary btn-pill">開始快速比對</a>
                <a href="/report-lost" class="btn btn-secondary btn-pill">登記協尋案件</a>
            </div>
        </section>
    </main>

    <script>
    let isFeaturedLoading = false;
    async function loadFeatured() {
        if (isFeaturedLoading) return;
        isFeaturedLoading = true;
        const container = document.getElementById('featured-animal');
        try {
            const res = await fetch('/api/animals/random');
            if (!res.ok) throw new Error();
            const { extras } = await res.json();
            const a = extras.animal;
            if (!a) {
                container.innerHTML = '<p class="featured-loading">目前沒有可顯示的動物。</p>';
                return;
            }
            const imgSrc = getAnimalImage(a, 720, 460);
            container.innerHTML = `
                <img class="featured-img" src="${escapeHtml(imgSrc)}" alt="${animalAltText(a)}">
                <div class="featured-body">
                    <p class="eyebrow">Featured animal</p>
                    <h3>${escapeHtml(a.variety || a.kind || '未知品種')}</h3>
                    <dl class="metadata-list">
                        <div><dt>物種</dt><dd>${escapeHtml(a.kind || '—')}</dd></div>
                        <div><dt>性別</dt><dd>${sexLabel(a.sex)}</dd></div>
                        <div><dt>毛色</dt><dd>${escapeHtml(a.colour || '—')}</dd></div>
                    </dl>
                    ${a.shelter_name ? `<span class="badge featured-shelter">${escapeHtml(a.shelter_name)}</span>` : ''}
                    <a class="text-link" href="/shelter-animals">瀏覽更多收容動物</a>
                </div>`;
        } catch {
            container.innerHTML = '<p class="featured-loading">無法載入動物資料。</p>';
        } finally {
            isFeaturedLoading = false;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadFeatured();
    });
    </script>
    <%- include('partials/_footer') %>
</body>
</html>
