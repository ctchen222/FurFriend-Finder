<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '協尋登記' }) %>
    <style>
        h1 { text-align: center; font-size: 2.2em; }
        .intro-text { text-align: center; margin-bottom: 32px; color: var(--text-color); }
        #submitBtn { margin-top: 8px; }
    </style>
</head>
<body>
    <%- include('partials/_header') %>
    <div id="toast" class="toast"></div>

    <div class="container--card">
        <h1>協尋寵物資料登記</h1>
        <p class="intro-text">請盡可能詳細地填寫以下資訊，以提高配對成功率。</p>

        <form id="lostPetForm">
            <fieldset>
                <legend>🐾 走失寵物資料</legend>
                <div class="form-group">
                    <label for="pet-name">寵物名字</label>
                    <input type="text" id="pet-name" name="animalLost[name]">
                </div>
                <div class="form-group">
                    <label for="pet-lost-time">走失時間</label>
                    <input type="date" id="pet-lost-time" name="animalLost[lost_time]">
                </div>
                <div class="form-group">
                    <label for="pet-kind">物種 <span style="color:#c00">*</span></label>
                    <select id="pet-kind" name="animalLost[kind]" required>
                        <option value="">請選擇</option>
                        <option value="狗">狗</option>
                        <option value="貓">貓</option>
                        <option value="其他">其他</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="pet-variety">品種</label>
                    <input type="text" id="pet-variety" name="animalLost[variety]" placeholder="例如: 米克斯, 貴賓">
                </div>
                <div class="form-group">
                    <label for="pet-sex">性別</label>
                    <select id="pet-sex" name="animalLost[sex]">
                        <option value="M">公</option>
                        <option value="F">母</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="pet-colour">毛色</label>
                    <input type="text" id="pet-colour" name="animalLost[colour]" placeholder="例如: 虎斑, 橘色, 黑白">
                </div>
                <div class="form-group">
                    <label for="pet-outlook">外觀</label>
                    <textarea id="pet-outlook" name="animalLost[outlook]" rows="2"
                        placeholder="例如: 親人、膽小、左耳有剪耳"></textarea>
                </div>
                <div class="form-group">
                    <label for="pet-feature">特徵</label>
                    <textarea id="pet-feature" name="animalLost[feature]" rows="2"
                        placeholder="例如: 尾巴是麒麟尾、項圈是藍色的"></textarea>
                </div>
                <div class="form-group">
                    <label for="pet-lost-place">走失地點 <span style="color:#c00">*</span></label>
                    <input type="text" id="pet-lost-place" name="animalLost[lost_place]" required
                        placeholder="例如：台北市信義區">
                </div>
            </fieldset>

            <fieldset>
                <legend>👤 飼主聯絡資訊</legend>
                <div class="form-group">
                    <label for="owner-name">您的姓名 <span style="color:#c00">*</span></label>
                    <input type="text" id="owner-name" name="animalOwner[name]"
                        value="<%= animalOwner.name || '' %>" required>
                </div>
                <div class="form-group">
                    <label for="owner-email">Email <span style="color:#c00">*</span></label>
                    <input type="email" id="owner-email" name="animalOwner[email]"
                        value="<%= animalOwner.email || '' %>" required>
                </div>
                <div class="form-group">
                    <label for="owner-phone">手機</label>
                    <input type="tel" id="owner-phone" name="animalOwner[phone]"
                        value="<%= animalOwner.phone || '' %>">
                </div>
            </fieldset>

            <button id="submitBtn" type="submit" class="btn btn-primary btn-pill btn-block">
                提交協尋案件
            </button>
        </form>
    </div>

    <script>
    document.getElementById('lostPetForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>提交中...';

        // Build nested object from form field names like animalLost[kind]
        const raw = new FormData(e.target);
        const animalLost = {};
        const animalOwner = {};
        for (const [key, val] of raw.entries()) {
            const m = key.match(/^(\w+)\[(\w+)\]$/);
            if (!m) continue;
            if (m[1] === 'animalLost')  animalLost[m[2]]  = val;
            if (m[1] === 'animalOwner') animalOwner[m[2]] = val;
        }

        try {
            const res = await fetch('/api/lost-animals', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ animalLost, animalOwner }),
            });

            if (res.redirected) {
                window.location.href = res.url;
                return;
            }
            if (res.ok) {
                showToast('協尋案件提交成功！正在跳轉…', 'success');
                setTimeout(() => { window.location.href = '/profile?message=report-success'; }, 1500);
            } else {
                const data = await res.json().catch(() => ({}));
                showToast(data?.error?.msg || '提交失敗，請確認填寫內容後再試', 'error');
                btn.disabled = false;
                btn.textContent = '提交協尋案件';
            }
        } catch {
            showToast('網路錯誤，請稍後再試', 'error');
            btn.disabled = false;
            btn.textContent = '提交協尋案件';
        }
    });
    </script>
</body>
</html>
