<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '收容所動物' }) %>
    <style>
        h1 { text-align: center; font-size: 2.2em; margin-bottom: 40px; }

        .animal-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
        }

        .animal-card {
            background-color: var(--card-bg-color);
            border-radius: 16px;
            box-shadow: 0 6px 20px var(--shadow-color);
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .animal-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        }

        .animal-card-img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            display: block;
            background-color: var(--border-color);
        }

        .animal-card-body { padding: 16px 20px 20px; }

        .animal-card-title {
            color: var(--heading-color);
            font-size: 1.2em;
            font-weight: bold;
            margin: 0 0 10px;
        }

        .animal-meta { margin: 0; font-size: 0.9em; color: var(--text-color); line-height: 1.6; }
        .animal-meta strong { color: var(--heading-color); }

        .shelter-tag {
            display: inline-block;
            margin-top: 10px;
            padding: 3px 10px;
            background-color: rgba(129, 166, 211, 0.15);
            border-radius: 20px;
            font-size: 0.82em;
            color: var(--primary-color);
            font-weight: bold;
        }

        .pagination-controls {
            text-align: center;
            margin-top: 40px;
            display: flex;
            justify-content: center;
            gap: 16px;
        }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 20px;
            color: #aaa;
            font-size: 1.1em;
        }
    </style>
</head>
<body>
    <div id="toast" class="toast"></div>
    <%- include('partials/_header') %>

    <div class="container--wide">
        <h1>收容所動物列表</h1>
        <div id="animal-grid" class="animal-grid">
            <p class="empty-state">載入中...</p>
        </div>

        <div class="pagination-controls">
            <button id="prev-page" class="btn btn-primary" disabled>← 上一頁</button>
            <button id="next-page" class="btn btn-primary" disabled>下一頁 →</button>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', async () => {
        const grid     = document.getElementById('animal-grid');
        const prevBtn  = document.getElementById('prev-page');
        const nextBtn  = document.getElementById('next-page');
        const PAGE_SIZE = 12;
        let prevCursor = null;
        let nextCursor = null;

        function sexLabel(s) {
            return s === 'M' ? '公' : s === 'F' ? '母' : s || '—';
        }

        function renderCard(animal) {
            const imgSrc = animal.picture || 'https://placehold.co/560x380/f4efe8/a77b5a?text=%F0%9F%90%BE';
            return `
                <div class="animal-card">
                    <img class="animal-card-img" src="${imgSrc}" alt="${animal.variety || '動物'}">
                    <div class="animal-card-body">
                        <p class="animal-card-title">${animal.variety || '未知品種'}</p>
                        <p class="animal-meta">
                            <strong>物種:</strong> ${animal.kind || '—'}<br>
                            <strong>性別:</strong> ${sexLabel(animal.sex)}<br>
                            <strong>毛色:</strong> ${animal.colour || '—'}
                        </p>
                        ${animal.shelter_name ? `<span class="shelter-tag">📍 ${animal.shelter_name}</span>` : ''}
                    </div>
                </div>`;
        }

        async function fetchAnimals(cursor = null) {
            grid.innerHTML = '<p class="empty-state">載入中...</p>';
            prevBtn.disabled = true;
            nextBtn.disabled = true;

            let url = `/api/animals?pageSize=${PAGE_SIZE}`;
            if (cursor) url += `&cursor=${cursor}`;

            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error('無法取得動物資料');
                const { extras } = await res.json();
                const animals  = extras.animals  || [];
                const cursors  = extras.cursors  || {};

                if (animals.length > 0) {
                    grid.innerHTML = animals.map(renderCard).join('');
                } else {
                    grid.innerHTML = '<p class="empty-state">目前沒有動物資料。</p>';
                }

                prevCursor = cursors.prevCursor || null;
                nextCursor = cursors.nextCursor || null;
                prevBtn.disabled = !prevCursor;
                nextBtn.disabled = !nextCursor;
            } catch (err) {
                grid.innerHTML = `<p class="empty-state">${err.message}</p>`;
            }
        }

        fetchAnimals();
        prevBtn.addEventListener('click', () => prevCursor && fetchAnimals(prevCursor));
        nextBtn.addEventListener('click', () => nextCursor && fetchAnimals(nextCursor));
    });
    </script>
</body>
</html>
