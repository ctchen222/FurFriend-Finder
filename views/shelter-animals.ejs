<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '收容所動物' }) %>
</head>
<body>
    <%- include('partials/_header') %>

    <div class="container--wide">
        <h1 class="page-title">收容所動物列表</h1>

        <div class="filter-bar">
            <div class="filter-group">
                <label for="filter-kind">物種</label>
                <select id="filter-kind">
                    <option value="">全部</option>
                    <option value="狗">狗</option>
                    <option value="貓">貓</option>
                    <option value="其他">其他</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="filter-city">縣市</label>
                <input type="text" id="filter-city" placeholder="例如：台北市" list="city-list">
                <datalist id="city-list">
                    <option value="台北市"></option><option value="新北市"></option>
                    <option value="桃園市"></option><option value="台中市"></option>
                    <option value="台南市"></option><option value="高雄市"></option>
                    <option value="新竹縣"></option><option value="新竹市"></option>
                    <option value="苗栗縣"></option><option value="彰化縣"></option>
                    <option value="南投縣"></option><option value="雲林縣"></option>
                    <option value="嘉義縣"></option><option value="嘉義市"></option>
                    <option value="屏東縣"></option><option value="宜蘭縣"></option>
                    <option value="花蓮縣"></option><option value="台東縣"></option>
                    <option value="澎湖縣"></option><option value="金門縣"></option>
                </datalist>
            </div>
            <div class="filter-group">
                <label for="filter-sex">性別</label>
                <select id="filter-sex">
                    <option value="">全部</option>
                    <option value="M">公</option>
                    <option value="F">母</option>
                </select>
            </div>
            <div class="filter-actions">
                <button id="filterBtn" class="btn btn-primary btn-sm">搜尋</button>
                <button id="resetBtn" class="btn btn-sm btn-secondary">重置</button>
            </div>
        </div>

        <p class="result-info" id="result-info"></p>
        <div id="animal-grid" class="animal-grid">
            <p class="empty-state">載入中...</p>
        </div>

        <div class="pagination-controls" id="pagination-controls">
            <button id="prev-page" class="btn btn-primary" disabled>← 上一頁</button>
            <button id="next-page" class="btn btn-primary" disabled>下一頁 →</button>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', async () => {
        const grid        = document.getElementById('animal-grid');
        const prevBtn     = document.getElementById('prev-page');
        const nextBtn     = document.getElementById('next-page');
        const pagination  = document.getElementById('pagination-controls');
        const resultInfo  = document.getElementById('result-info');
        const filterBtn   = document.getElementById('filterBtn');
        const resetBtn    = document.getElementById('resetBtn');

        const PAGE_SIZE = 12;
        let prevCursor = null;
        let nextCursor = null;
        const pageCursors = [null];
        let currentPageIndex = 0;
        // Current filter state
        let activeCity = '';
        let activeKind = '';
        let activeSex  = '';
        let isCityMode = false; // city API returns all results (no pagination)

        // Map from rendered card index → animal data (for lightbox)
        const animalMap = new Map();

        function renderCard(animal) {
            const imgSrc = animal.picture || 'https://placehold.co/560x380/f4efe8/a77b5a?text=%F0%9F%90%BE';
            const cardId = `card-${animal.id || Math.random().toString(36).slice(2)}`;
            animalMap.set(cardId, animal);
            return `
                <div class="animal-card clickable" data-card-id="${cardId}" tabindex="0" role="button">
                    <img class="animal-card-img" src="${escapeHtml(imgSrc)}" alt="${escapeHtml(animal.variety || '動物')}">
                    <div class="animal-card-body">
                        <p class="animal-card-title">${escapeHtml(animal.variety || '未知品種')}</p>
                        <p class="animal-meta">
                            <strong>物種:</strong> ${escapeHtml(animal.kind || '—')}&nbsp;&nbsp;
                            <strong>性別:</strong> ${sexLabel(animal.sex)}&nbsp;&nbsp;
                            <strong>毛色:</strong> ${escapeHtml(animal.colour || '—')}
                        </p>
                        ${animal.shelter_name ? `<span class="badge shelter-tag">📍 ${escapeHtml(animal.shelter_name)}</span>` : ''}
                    </div>
                </div>`;
        }

        function applyClientFilters(animals) {
            return animals.filter(a => {
                if (activeKind && a.kind !== activeKind) return false;
                if (activeSex  && a.sex  !== activeSex)  return false;
                return true;
            });
        }

        function showAnimals(animals, total) {
            const filtered = applyClientFilters(animals);
            if (filtered.length > 0) {
                grid.innerHTML = filtered.map(renderCard).join('');
            } else {
                grid.innerHTML = '<p class="empty-state">😔 沒有符合條件的動物，請嘗試放寬篩選條件。</p>';
            }
            resultInfo.textContent = total != null
                ? `共找到 ${filtered.length} 筆結果`
                : `目前顯示 ${filtered.length} 筆`;
        }

        async function fetchByCity(city) {
            grid.innerHTML = '<p class="empty-state">搜尋中...</p>';
            pagination.style.display = 'none';
            try {
                const res = await fetch(`/api/animals/city/${encodeURIComponent(city)}`);
                if (!res.ok) throw new Error('搜尋失敗');
                const { extras } = await res.json();
                const animals = extras.animals || [];
                showAnimals(animals, animals.length);
            } catch (err) {
                grid.innerHTML = `<p class="empty-state">${err.message}</p>`;
            }
        }

        function resetPaginationState() {
            pageCursors.length = 1;
            pageCursors[0] = null;
            currentPageIndex = 0;
            prevCursor = null;
            nextCursor = null;
        }

        async function fetchPage(cursor = null, pageIndex = 0) {
            grid.innerHTML = '<p class="empty-state">載入中...</p>';
            pagination.style.display = 'flex';
            prevBtn.disabled = true;
            nextBtn.disabled = true;

            let url = `/api/animals?pageSize=${PAGE_SIZE}`;
            if (cursor) url += `&cursor=${cursor}`;

            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error('無法取得動物資料');
                const { extras } = await res.json();
                const animals = extras.animals || [];
                const cursors = extras.cursors || {};

                showAnimals(animals, null);
                currentPageIndex = pageIndex;
                pageCursors.splice(currentPageIndex + 1);
                prevCursor = currentPageIndex > 0 ? pageCursors[currentPageIndex - 1] : null;
                nextCursor = cursors.nextCursor || null;
                prevBtn.disabled = currentPageIndex === 0;
                nextBtn.disabled = !nextCursor;
            } catch (err) {
                grid.innerHTML = `<p class="empty-state">${err.message}</p>`;
            }
        }

        filterBtn.addEventListener('click', () => {
            activeKind = document.getElementById('filter-kind').value;
            activeSex  = document.getElementById('filter-sex').value;
            activeCity = document.getElementById('filter-city').value.trim();

            if (activeCity) {
                isCityMode = true;
                resetPaginationState();
                fetchByCity(activeCity);
            } else {
                isCityMode = false;
                resetPaginationState();
                fetchPage();
            }
        });

        resetBtn.addEventListener('click', () => {
            document.getElementById('filter-kind').value = '';
            document.getElementById('filter-sex').value  = '';
            document.getElementById('filter-city').value = '';
            activeKind = ''; activeSex = ''; activeCity = '';
            isCityMode = false;
            resetPaginationState();
            pagination.style.display = 'flex';
            fetchPage();
        });

        // Event delegation for lightbox — works even after grid re-renders
        grid.addEventListener('click', (e) => {
            const card = e.target.closest('[data-card-id]');
            if (!card) return;
            const animal = animalMap.get(card.dataset.cardId);
            if (animal) openLightbox(animal, animal.id || null);
        });

        grid.addEventListener('keydown', (e) => {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            const card = e.target.closest('[data-card-id]');
            if (!card) return;
            e.preventDefault();
            const animal = animalMap.get(card.dataset.cardId);
            if (animal) openLightbox(animal, animal.id || null);
        });

        prevBtn.addEventListener('click', () => {
            if (currentPageIndex === 0) return;
            const targetPageIndex = currentPageIndex - 1;
            fetchPage(pageCursors[targetPageIndex], targetPageIndex);
        });
        nextBtn.addEventListener('click', () => {
            if (!nextCursor) return;
            const targetPageIndex = currentPageIndex + 1;
            pageCursors[targetPageIndex] = nextCursor;
            fetchPage(nextCursor, targetPageIndex);
        });

        fetchPage();
    });
    </script>
    <%- include('partials/_footer') %>
</body>
</html>
