<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '註冊' }) %>
</head>
<body class="auth-layout">
    <div id="toast" class="toast"></div>
    <main class="auth-card">
        <a href="/" class="auth-brand">FurFriend Finder</a>
        <p class="eyebrow">Create account</p>
        <h1>註冊新帳號</h1>
        <p class="auth-copy">建立帳號後，可以登記協尋案件並接收後續配對通知。</p>
        <form action="/api/auth/signup" method="POST">
            <div class="form-group">
                <label for="name">姓名</label>
                <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label for="password">密碼</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-submit">註冊</button>
        </form>
        <% if ((process.env.GOOGLE_OAUTH_ENABLED || '').toLowerCase() === 'true') { %>
        <div class="oauth-divider"><span>或</span></div>
        <button type="button" class="btn btn-secondary btn-block google-sign-in" data-return-to="/profile"><span aria-hidden="true">G</span> 使用 Google 繼續</button>
        <script src="/js/google-auth.js" defer></script>
        <% } %>
        <div class="switch-link">
            <p>已經有帳號了？ <a href="/login">點此登入</a></p>
            <p><a href="/">返回首頁</a></p>
        </div>
    </main>
</body>
</html>
