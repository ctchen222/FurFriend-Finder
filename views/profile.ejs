<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '個人資料' }) %>
</head>
<body>
    <%- include('partials/_header') %>

    <div class="container">
        <h1 class="page-title">個人資料</h1>

        <div class="card">
            <h2>👤 您的資訊</h2>
            <div class="profile-info">
                <p><strong>姓名:</strong> <%= user.name %></p>
                <p><strong>Email:</strong> <%= user.email %></p>
            </div>
        </div>

        <div class="card">
            <h2>⚙️ 通知設定</h2>
            <div class="setting-item">
                <label for="mail-notification">開啟遺失動物郵件通知</label>
                <label class="switch">
                    <input type="checkbox" id="mail-notification" <%= user.isLostAnimalMailEnabled ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
            </div>
            <p id="save-status" class="save-status"></p>
            <hr class="divider">
            <div class="setting-item disabled">
                <label for="sms-notification">
                    開啟手機簡訊通知
                    <span class="coming-soon">(即將推出)</span>
                </label>
                <label class="switch">
                    <input type="checkbox" id="sms-notification" disabled>
                    <span class="slider round"></span>
                </label>
            </div>
        </div>

        <div class="card">
            <h2>🐾 我協尋的寵物</h2>
            <% if (lostAnimals && lostAnimals.length > 0) { %>
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>寵物名字</th>
                            <th>物種 / 品種</th>
                            <th>性別 / 毛色</th>
                            <th>走失時間</th>
                            <th>走失地點</th>
                            <th>狀態</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% lostAnimals.forEach(animal => { %>
                        <tr>
                            <td><%= animal.name || '—' %></td>
                            <td><%= animal.kind %> / <%= animal.variety || '—' %></td>
                            <td><%= animal.sex === 'M' ? '公' : '母' %> / <%= animal.colour || '—' %></td>
                            <td><%= animal.lost_time ? new Date(animal.lost_time).toLocaleDateString('zh-TW') : '—' %></td>
                            <td><%= animal.lost_place %></td>
                            <td>
                                <span class="badge status-badge pending" data-id="<%= animal.id %>-status">待配對</span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary match-btn" data-id="<%= animal.id %>">
                                    發送配對通知
                                </button>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <p>您目前沒有登記任何協尋案件。<a href="/report-lost">立即登記</a></p>
            <% } %>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        // Restore notified status from sessionStorage
        document.querySelectorAll('.status-badge[data-id]').forEach(badge => {
            const id = badge.dataset.id.replace('-status', '');
            if (sessionStorage.getItem(`matched_${id}`)) {
                badge.textContent = '已通知';
                badge.className = 'badge status-badge notified';
            }
        });

        // Toggle mail notification
        const toggle = document.getElementById('mail-notification');
        const status = document.getElementById('save-status');
        toggle.addEventListener('change', async (event) => {
            const isEnabled = event.target.checked;
            status.textContent = '儲存中...';
            try {
                const res = await fetch('/api/auth/settings', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isLostAnimalMailEnabled: isEnabled }),
                });
                if (!res.ok) throw new Error();
                status.textContent = '✓ 已儲存';
            } catch {
                status.textContent = '儲存失敗，請重試';
                event.target.checked = !isEnabled;
            }
            setTimeout(() => { status.textContent = ''; }, 2000);
        });

        // Match buttons
        document.querySelectorAll('.match-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const badge = document.querySelector(`.status-badge[data-id="${id}-status"]`);
                const original = btn.textContent;
                setButtonLoading(btn, '發送中...');
                try {
                    const res = await fetch(`/api/lost-animals/match/${id}`);
                    if (!res.ok) throw new Error();
                    const result = await res.json();
                    const found = result.extras?.top10Matches?.length > 0;
                    showToast(found ? '✓ 配對通知已發送！' : '目前沒有找到符合的動物', found ? 'success' : 'error');
                    if (found && badge) {
                        badge.textContent = '已通知';
                        badge.className = 'badge status-badge notified';
                        sessionStorage.setItem(`matched_${id}`, '1');
                        btn.textContent = '✓ 已發送';
                        btn.classList.add('btn-success');
                        // Don't reset — user can see the result persists
                    } else {
                        btn.textContent = '無配對';
                        btn.disabled = false;
                        setTimeout(() => {
                            btn.textContent = original;
                        }, 3000);
                    }
                } catch {
                    showToast('發送失敗，請稍後再試', 'error');
                    btn.textContent = original;
                    btn.disabled = false;
                    return;
                }
            });
        });
    });
    </script>
    <%- include('partials/_footer') %>
</body>
</html>
