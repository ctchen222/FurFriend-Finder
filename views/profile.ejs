<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '個人資料' }) %>
</head>
<body>
    <%- include('partials/_header') %>

    <main class="profile-page container">
        <section class="page-hero page-hero--compact page-hero--left">
            <p class="eyebrow">Profile</p>
            <h1 class="page-title">個人資料</h1>
            <p class="page-subtitle">管理通知偏好，查看已建立的協尋案件，必要時手動重新發送配對通知。</p>
        </section>

        <section class="profile-grid">
            <article class="card">
                <h2>您的資訊</h2>
                <div class="profile-info">
                    <p><strong>姓名</strong> <%= user.name %></p>
                    <p><strong>Email</strong> <%= user.email %></p>
                </div>
            </article>

            <article class="card">
                <h2>通知設定</h2>
                <div class="setting-item">
                    <div>
                        <label for="mail-notification">遺失動物 Email 通知</label>
                        <p class="setting-copy">有候選結果時，系統可透過 Email 提醒你。</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" id="mail-notification" <%= user.isLostAnimalMailEnabled ? 'checked' : '' %>>
                        <span class="slider round"></span>
                    </label>
                </div>
                <p id="save-status" class="save-status"></p>
                <hr class="divider">
                <div class="setting-item disabled">
                    <div>
                        <label for="sms-notification">手機簡訊通知 <span class="coming-soon">即將推出</span></label>
                        <p class="setting-copy">第一版先以 Email 通知為主。</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" id="sms-notification" disabled>
                        <span class="slider round"></span>
                    </label>
                </div>
            </article>
        </section>

        <section class="card">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Lost reports</p>
                    <h2>我協尋的寵物</h2>
                </div>
                <a class="btn btn-secondary btn-sm" href="/report-lost">新增案件</a>
            </div>
            <% if (lostAnimals && lostAnimals.length > 0) { %>
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>寵物名字</th>
                            <th>物種 / 品種</th>
                            <th>性別 / 毛色</th>
                            <th>走失時間</th>
                            <th>走失地點</th>
                            <th>狀態</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% lostAnimals.forEach(animal => { %>
                        <tr>
                            <td><%= animal.name || '—' %></td>
                            <td><%= animal.kind %> / <%= animal.variety || '—' %></td>
                            <td><%= animal.sex === 'M' ? '公' : '母' %> / <%= animal.colour || '—' %></td>
                            <td><%= animal.lost_time ? new Date(animal.lost_time).toLocaleDateString('zh-TW') : '—' %></td>
                            <td><%= animal.lost_place %></td>
                            <td>
                                <span class="badge status-badge pending" data-id="<%= animal.id %>-status">待配對</span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary match-btn" data-id="<%= animal.id %>">
                                    發送配對通知
                                </button>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="empty-state empty-state--panel">
                <h3>目前沒有協尋案件</h3>
                <p>建立案件後，可以在這裡追蹤通知狀態並重新執行配對。</p>
                <a href="/report-lost" class="btn btn-primary">立即登記</a>
            </div>
            <% } %>
        </section>
    </main>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.status-badge[data-id]').forEach(badge => {
            const id = badge.dataset.id.replace('-status', '');
            if (sessionStorage.getItem(`matched_${id}`)) {
                badge.textContent = '已通知';
                badge.className = 'badge status-badge notified';
            }
        });

        const toggle = document.getElementById('mail-notification');
        const status = document.getElementById('save-status');
        toggle.addEventListener('change', async (event) => {
            const isEnabled = event.target.checked;
            status.textContent = '儲存中...';
            try {
                const res = await fetch('/api/auth/settings', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isLostAnimalMailEnabled: isEnabled }),
                });
                if (!res.ok) throw new Error();
                status.textContent = '已儲存';
            } catch {
                status.textContent = '儲存失敗，請重試';
                event.target.checked = !isEnabled;
            }
            setTimeout(() => { status.textContent = ''; }, 2000);
        });

        document.querySelectorAll('.match-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const badge = document.querySelector(`.status-badge[data-id="${id}-status"]`);
                const original = btn.textContent;
                setButtonLoading(btn, '發送中...');
                try {
                    const res = await fetch(`/api/lost-animals/match/${id}`);
                    if (!res.ok) throw new Error();
                    const result = await res.json();
                    const found = result.extras?.top10Matches?.length > 0;
                    showToast(found ? '配對通知已發送。' : '目前沒有找到符合的動物', found ? 'success' : 'error');
                    if (found && badge) {
                        badge.textContent = '已通知';
                        badge.className = 'badge status-badge notified';
                        sessionStorage.setItem(`matched_${id}`, '1');
                        btn.textContent = '已發送';
                        btn.classList.add('btn-success');
                    } else {
                        btn.textContent = '無配對';
                        btn.disabled = false;
                        setTimeout(() => {
                            btn.textContent = original;
                        }, 3000);
                    }
                } catch {
                    showToast('發送失敗，請稍後再試', 'error');
                    btn.textContent = original;
                    btn.disabled = false;
                    return;
                }
            });
        });
    });
    </script>
    <%- include('partials/_footer') %>
</body>
</html>
