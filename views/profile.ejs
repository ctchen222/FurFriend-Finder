<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '個人資料' }) %>
    <style>
        h1 { text-align: center; font-size: 2.2em; margin-bottom: 40px; }

        .profile-info p { font-size: 1.1em; margin: 0 0 10px; }
        .profile-info strong { color: var(--heading-color); margin-right: 10px; }

        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1.1em;
        }
        .setting-item.disabled { opacity: 0.5; cursor: not-allowed; }
        .coming-soon { font-size: 0.8em; color: #999; margin-left: 5px; }

        .save-status {
            margin-top: 12px;
            font-style: italic;
            color: var(--primary-color);
            text-align: right;
            min-height: 1.2em;
            font-size: 0.95em;
        }

        /* Responsive table wrapper */
        .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

        .status-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.8em;
            font-weight: bold;
        }
        .status-badge.pending  { background: rgba(255,183,77,0.2); color: #e65100; }
        .status-badge.notified { background: rgba(76,175,80,0.2);  color: #2e7d32; }
    </style>
</head>
<body>
    <%- include('partials/_header') %>
    <div id="toast" class="toast"></div>

    <div class="container">
        <h1>個人資料</h1>

        <div class="card">
            <h2>👤 您的資訊</h2>
            <div class="profile-info">
                <p><strong>姓名:</strong> <%= user.name %></p>
                <p><strong>Email:</strong> <%= user.email %></p>
            </div>
        </div>

        <div class="card">
            <h2>⚙️ 通知設定</h2>
            <div class="setting-item">
                <label for="mail-notification">開啟遺失動物郵件通知</label>
                <label class="switch">
                    <input type="checkbox" id="mail-notification" <%= user.isLostAnimalMailEnabled ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
            </div>
            <p id="save-status" class="save-status"></p>
            <hr class="divider">
            <div class="setting-item disabled">
                <label for="sms-notification">
                    開啟手機簡訊通知
                    <span class="coming-soon">(即將推出)</span>
                </label>
                <label class="switch">
                    <input type="checkbox" id="sms-notification" disabled>
                    <span class="slider round"></span>
                </label>
            </div>
        </div>

        <div class="card">
            <h2>🐾 我協尋的寵物</h2>
            <% if (lostAnimals && lostAnimals.length > 0) { %>
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>寵物名字</th>
                            <th>物種 / 品種</th>
                            <th>性別 / 毛色</th>
                            <th>走失時間</th>
                            <th>走失地點</th>
                            <th>狀態</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% lostAnimals.forEach(animal => { %>
                        <tr>
                            <td><%= animal.name || '—' %></td>
                            <td><%= animal.kind %> / <%= animal.variety || '—' %></td>
                            <td><%= animal.sex === 'M' ? '公' : '母' %> / <%= animal.colour || '—' %></td>
                            <td><%= animal.lost_time ? new Date(animal.lost_time).toLocaleDateString('zh-TW') : '—' %></td>
                            <td><%= animal.lost_place %></td>
                            <td>
                                <span class="status-badge pending" data-id="<%= animal.id %>-status">待配對</span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary match-btn" data-id="<%= animal.id %>">
                                    發送配對通知
                                </button>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <p>您目前沒有登記任何協尋案件。<a href="/report-lost">立即登記</a></p>
            <% } %>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        // Restore notified status from sessionStorage
        document.querySelectorAll('.status-badge[data-id]').forEach(badge => {
            const id = badge.dataset.id.replace('-status', '');
            if (sessionStorage.getItem(`matched_${id}`)) {
                badge.textContent = '已通知';
                badge.className = 'status-badge notified';
            }
        });

        // Toggle mail notification
        const toggle = document.getElementById('mail-notification');
        const status = document.getElementById('save-status');
        toggle.addEventListener('change', async (event) => {
            const isEnabled = event.target.checked;
            status.textContent = '儲存中...';
            try {
                const res = await fetch('/api/auth/settings', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isLostAnimalMailEnabled: isEnabled }),
                });
                if (!res.ok) throw new Error();
                status.textContent = '✓ 已儲存';
            } catch {
                status.textContent = '儲存失敗，請重試';
                event.target.checked = !isEnabled;
            }
            setTimeout(() => { status.textContent = ''; }, 2000);
        });

        // Match buttons
        document.querySelectorAll('.match-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const badge = document.querySelector(`.status-badge[data-id="${id}-status"]`);
                const original = btn.textContent;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner"></span>發送中...';
                try {
                    const res = await fetch(`/api/lost-animals/match/${id}`);
                    if (!res.ok) throw new Error();
                    const result = await res.json();
                    const found = result.extras?.top10Matches?.length > 0;
                    showToast(found ? '✓ 配對通知已發送！' : '目前沒有找到符合的動物', found ? 'success' : 'error');
                    if (found && badge) {
                        badge.textContent = '已通知';
                        badge.className = 'status-badge notified';
                        sessionStorage.setItem(`matched_${id}`, '1');
                        btn.textContent = '✓ 已發送';
                        btn.style.background = 'var(--success-color)';
                        // Don't reset — user can see the result persists
                    } else {
                        btn.textContent = '無配對';
                        btn.disabled = false;
                        setTimeout(() => {
                            btn.textContent = original;
                        }, 3000);
                    }
                } catch {
                    showToast('發送失敗，請稍後再試', 'error');
                    btn.textContent = original;
                    btn.disabled = false;
                    return;
                }
            });
        });
    });
    </script>
</body>
</html>
