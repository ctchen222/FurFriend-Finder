<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '個人資料' }) %>
    <style>
        h1 { text-align: center; font-size: 2.2em; margin-bottom: 40px; }

        .profile-info p { font-size: 1.1em; margin: 0 0 10px; }
        .profile-info strong { color: var(--heading-color); margin-right: 10px; }

        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1.1em;
        }
        .setting-item.disabled { opacity: 0.5; cursor: not-allowed; }
        .coming-soon { font-size: 0.8em; color: #999; margin-left: 5px; }

        .save-status {
            margin-top: 12px;
            font-style: italic;
            color: var(--primary-color);
            text-align: right;
            min-height: 1.2em;
            font-size: 0.95em;
        }
    </style>
</head>
<body>
    <%- include('partials/_header') %>
    <div id="toast" class="toast"></div>

    <div class="container">
        <h1>個人資料</h1>

        <div class="card">
            <h2>👤 您的資訊</h2>
            <div class="profile-info">
                <p><strong>姓名:</strong> <%= user.name %></p>
                <p><strong>Email:</strong> <%= user.email %></p>
            </div>
        </div>

        <div class="card">
            <h2>⚙️ 通知設定</h2>
            <div class="setting-item">
                <label for="mail-notification">開啟遺失動物郵件通知</label>
                <label class="switch">
                    <input type="checkbox" id="mail-notification" <%= user.isLostAnimalMailEnabled ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
            </div>
            <p id="save-status" class="save-status"></p>
            <hr class="divider">
            <div class="setting-item disabled">
                <label for="sms-notification">
                    開啟手機簡訊通知
                    <span class="coming-soon">(即將推出)</span>
                </label>
                <label class="switch">
                    <input type="checkbox" id="sms-notification" disabled>
                    <span class="slider round"></span>
                </label>
            </div>
        </div>

        <div class="card">
            <h2>🐾 我協尋的寵物</h2>
            <% if (lostAnimals && lostAnimals.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>寵物名字</th>
                        <th>物種</th>
                        <th>性別</th>
                        <th>走失時間</th>
                        <th>走失地點</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    <% lostAnimals.forEach(animal => { %>
                    <tr>
                        <td><%= animal.name %></td>
                        <td><%= animal.kind %></td>
                        <td><%= animal.sex %></td>
                        <td><%= new Date(animal.lost_time).toLocaleDateString() %></td>
                        <td><%= animal.lost_place %></td>
                        <td>
                            <button class="btn btn-sm btn-primary match-btn" data-id="<%= animal.id %>">
                                發送配對通知
                            </button>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <p>您目前沒有登記任何協尋案件。<a href="/report-lost">立即登記</a></p>
            <% } %>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        // Toggle mail notification setting
        const toggle = document.getElementById('mail-notification');
        const status = document.getElementById('save-status');
        toggle.addEventListener('change', async (event) => {
            const isEnabled = event.target.checked;
            status.textContent = '儲存中...';
            try {
                const res = await fetch('/api/auth/settings', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isLostAnimalMailEnabled: isEnabled }),
                });
                if (!res.ok) throw new Error();
                status.textContent = '✓ 已儲存';
            } catch {
                status.textContent = '儲存失敗，請重試';
                event.target.checked = !isEnabled;
            }
            setTimeout(() => { status.textContent = ''; }, 2000);
        });

        // Match buttons with loading state
        document.querySelectorAll('.match-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const original = btn.textContent;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner"></span>發送中...';
                try {
                    const res = await fetch(`/api/lost-animals/match/${id}`);
                    if (!res.ok) throw new Error();
                    const result = await res.json();
                    const found = result.extras?.top10Matches?.length > 0;
                    showToast(found ? '✓ 配對通知已發送！' : '目前沒有找到符合的動物', found ? 'success' : 'error');
                    btn.textContent = found ? '✓ 已發送' : '無配對';
                } catch {
                    showToast('發送失敗，請稍後再試', 'error');
                    btn.textContent = original;
                    btn.disabled = false;
                }
                setTimeout(() => {
                    btn.textContent = original;
                    btn.disabled = false;
                }, 3000);
            });
        });
    });
    </script>
</body>
</html>
