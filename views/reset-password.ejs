<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '重設密碼' }) %>
</head>
<body class="auth-layout">
    <div id="toast" class="toast"></div>
    <main class="auth-card">
        <a href="/" class="auth-brand">FurFriend Finder</a>
        <p class="eyebrow">Account</p>
        <h1>重設密碼</h1>
        <p class="auth-copy">設定新的登入密碼後，請回到登入頁重新登入。</p>

        <% if (error) { %>
            <div class="empty-state empty-state--panel">
                <h3>連結無效或已過期</h3>
                <p>請回到登入頁重新寄送密碼重設連結。</p>
                <a class="btn btn-primary btn-block" href="/login">返回登入</a>
            </div>
        <% } else if (!token) { %>
            <div class="empty-state empty-state--panel">
                <h3>缺少重設 Token</h3>
                <p>請使用信件中的密碼重設連結開啟此頁。</p>
                <a class="btn btn-primary btn-block" href="/login">返回登入</a>
            </div>
        <% } else { %>
            <form id="resetPasswordForm">
                <input type="hidden" id="reset-token" value="<%= token %>">
                <div class="form-group">
                    <label for="new-password">新密碼</label>
                    <input type="password" id="new-password" name="newPassword" autocomplete="new-password" required minlength="8">
                </div>
                <div class="form-group">
                    <label for="confirm-password">確認新密碼</label>
                    <input type="password" id="confirm-password" autocomplete="new-password" required minlength="8">
                </div>
                <button type="submit" class="btn btn-primary btn-block btn-submit">更新密碼</button>
            </form>
        <% } %>

        <div class="switch-link">
            <p><a href="/login">返回登入</a></p>
        </div>
    </main>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('resetPasswordForm');
        if (!form) return;

        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            const token = document.getElementById('reset-token').value;
            const newPassword = document.getElementById('new-password').value;
            const confirmPassword = document.getElementById('confirm-password').value;
            const button = form.querySelector('button[type="submit"]');

            if (newPassword !== confirmPassword) {
                showToast('兩次輸入的密碼不一致。', 'error');
                return;
            }

            setButtonLoading(button, '更新中...');
            try {
                const response = await fetch('/api/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token, newPassword }),
                });

                if (!response.ok) {
                    throw new Error();
                }

                window.location.href = `/login?message=${window.APP_MESSAGE_KEYS.RESET_PASSWORD_SUCCESS}`;
            } catch {
                showToast('密碼重設失敗，請重新寄送連結。', 'error');
                resetButton(button, '更新密碼');
            }
        });
    });
    </script>
</body>
</html>
