<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '登入' }) %>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            background-image: none;
        }

        .auth-card {
            width: 100%;
            max-width: 420px;
            padding: 40px;
            background-color: var(--card-bg-color);
            border-radius: 20px;
            box-shadow: 0 10px 30px var(--shadow-color);
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 8px;
            font-size: 2em;
        }

        h1 {
            color: var(--heading-color);
            text-align: center;
            font-size: 1.6em;
            margin-top: 0;
            margin-bottom: 28px;
        }

        .switch-link {
            text-align: center;
            margin-top: 20px;
            font-size: 0.95em;
        }
        .switch-link a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div id="toast" class="toast"></div>
    <div class="auth-card">
        <div class="auth-logo">🐾</div>
        <h1>登入 FurFriend Finder</h1>
        <form id="loginForm" action="/api/auth/login" method="POST">
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label for="password">密碼</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 8px;">登入</button>
        </form>
        <div class="switch-link">
            <p>沒有帳號？ <a href="/register">點此註冊</a></p>
            <p><a href="/">返回首頁</a> · <a href="/quick-use">快速使用</a></p>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const message  = urlParams.get('message');
        const returnTo = urlParams.get('returnTo');

        // Show toast for message keys (e.g. login-failed) or legacy ?error= params
        if (message) {
            handleUrlMessages();
        }

        // Patch form to carry returnTo back to authController
        if (returnTo) {
            const form = document.getElementById('loginForm');
            if (form) {
                const input = document.createElement('input');
                input.type  = 'hidden';
                input.name  = 'returnTo';
                input.value = decodeURIComponent(returnTo);
                form.appendChild(input);
            }
        }

        window.history.replaceState({}, document.title, window.location.pathname);
    });
    </script>
</body>
</html>
