<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <%- include('partials/_head', { title: '登入' }) %>
</head>
<body class="auth-layout">
    <div id="toast" class="toast"></div>
    <main class="auth-card">
        <a href="/" class="auth-brand">FurFriend Finder</a>
        <p class="eyebrow">Account</p>
        <h1>登入 FurFriend Finder</h1>
        <p class="auth-copy">登入後可以建立協尋案件、管理通知設定，並保留後續配對通知。</p>
        <form id="loginForm" action="/api/auth/login" method="POST">
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label for="password">密碼</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-submit">登入</button>
        </form>
        <% if ((process.env.GOOGLE_OAUTH_ENABLED || '').toLowerCase() === 'true') { %>
        <div class="oauth-divider"><span>或</span></div>
        <button type="button" class="btn btn-secondary btn-block google-sign-in" data-return-to="<%= returnTo || '/profile' %>"><span aria-hidden="true">G</span> 使用 Google 繼續</button>
        <script src="/js/google-auth.js" defer></script>
        <% } %>
        <div class="switch-link">
            <p>沒有帳號？ <a href="/register">點此註冊</a></p>
            <p><a href="/forgot-password">忘記密碼？</a></p>
            <p><a href="/">返回首頁</a> · <a href="/quick-use">快速比對</a></p>
        </div>
    </main>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const returnTo = new URLSearchParams(window.location.search).get('returnTo');
        if (returnTo) {
            const form = document.getElementById('loginForm');
            if (form) {
                const input = document.createElement('input');
                input.type  = 'hidden';
                input.name  = 'returnTo';
                input.value = decodeURIComponent(returnTo);
                form.appendChild(input);
            }
        }
    });
    </script>
</body>
</html>
